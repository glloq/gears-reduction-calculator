{
  "name": "gears-reduction-calculator",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check:js": "find js -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "npm run check:js && node --test tests/*.test.js",
    "check:pages": "node tests/pages-check.js",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/visual-regression.spec.js",
    "test:visual:update": "playwright test tests/e2e/visual-regression.spec.js --update-snapshots"
  },
  "devDependencies": { "@playwright/test": "1.54.2" }
}
